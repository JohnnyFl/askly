# Paddle Configuration - Copy to .env and fill in your values
# DO NOT commit .env to git!

# Paddle API Key (get from Paddle Dashboard → Developer Tools → Authentication)
# Sandbox: starts with "test_"
# Production: starts with "live_"
PADDLE_API_KEY=test_your_paddle_api_key_here

# Webhook Secret (get from Paddle Dashboard → Developer Tools → Notifications)
# Format: pdl_ntfset_...
PADDLE_WEBHOOK_SECRET=pdl_ntfset_your_webhook_secret_here

# Environment (sandbox or production)
PADDLE_ENVIRONMENT=sandbox

# Price IDs (get from Paddle Dashboard → Catalog → Products)
# Format: pri_01...
PADDLE_PRO_MONTHLY_PRICE_ID=pri_01_your_pro_monthly_id
PADDLE_PRO_ANNUAL_PRICE_ID=pri_01_your_pro_annual_id
PADDLE_PREMIUM_MONTHLY_PRICE_ID=pri_01_your_premium_monthly_id
PADDLE_PREMIUM_ANNUAL_PRICE_ID=pri_01_your_premium_annual_id
